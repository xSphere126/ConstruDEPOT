---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { todasLasMarcas } from '../data/marcas';

const categoriasBase = [
  {
    id: 'estructura-y-obra',
    nombre: 'Estructura y Obra',
    desc: 'Los materiales de base para que cualquier construcción empiece con buenos cimientos.',
    // Palabras de zona/habitación que alguien sin vocabulario técnico podría
    // buscar en vez del nombre de la categoría — no añaden ningún criterio
    // técnico nuevo, solo sinónimos para encontrar la misma categoría real.
    zonas: ['fachada'],
    productos: [
      'Hormigón preparado', 'Cemento gris y blanco', 'Ladrillo cerámico', 'Bloque de hormigón',
      'Mortero de cemento', 'Morteros técnicos', 'Arena y gravas', 'Mallas y varillas de armado',
      'Aditivos para hormigón', 'Bovedillas', 'Placas de Pladur', 'Perfilería de Pladur y escayola',
      'Yesos y escayola', 'Prefabricados de hormigón', 'Tejas cerámicas y de hormigón', 'Lana de roca y de vidrio',
    ],
  },
  {
    id: 'acabados-y-revestimientos',
    nombre: 'Acabados y Revestimientos',
    desc: 'El punto final que define el estilo de cada espacio.',
    zonas: ['salón', 'suelos', 'interior'],
    productos: [
      'Gres porcelánico', 'Pavimento cerámico', 'Azulejo de pared', 'Parqué flotante',
      'Suelo vinílico (SPC/LVT)', 'Rodapiés y perfilería', 'Piedra natural', 'Adhesivos y juntas de alicatado',
      'Terrazos y baldosas', 'Material cerámico refractario',
    ],
  },
  {
    id: 'decoracion-y-pintura',
    nombre: 'Decoración y Pintura',
    desc: 'Todo lo necesario para dar el último toque, dentro y fuera.',
    zonas: [],
    productos: [
      'Pintura plástica interior', 'Pintura de fachada', 'Esmaltes sintéticos', 'Imprimaciones y selladores',
      'Barnices para madera', 'Rodillos y brochas', 'Cintas y protección', 'Pasta niveladora',
    ],
  },
  {
    id: 'fontaneria-y-climatizacion',
    nombre: 'Fontanería y Climatización',
    desc: 'Instalaciones que no se ven pero que marcan la diferencia en el día a día.',
    zonas: ['baño', 'cocina'],
    productos: [
      'Grifería de baño y cocina', 'Sanitarios e inodoros', 'Platos de ducha y mamparas', 'Tubería PVC y multicapa',
      'Bombas de agua', 'Radiadores', 'Aire acondicionado', 'Termos eléctricos', 'Válvulas y racores',
      'Bañeras e hidromasaje', 'Fregaderos de cocina', 'Muebles y espejos de baño',
    ],
  },
  {
    id: 'jardin-y-exterior',
    nombre: 'Jardín y Exterior',
    desc: 'Para que el exterior de tu casa o proyecto esté a la altura del interior.',
    zonas: ['terraza', 'patio'],
    productos: [
      'Hormigón impreso', 'Césped artificial', 'Adoquín y baldosa de exterior', 'Piedra decorativa',
      'Vallas y cerramientos', 'Iluminación exterior', 'Riego y goteo', 'Macetas y jardineras',
    ],
  },
];

// Las marcas de cada categoría se derivan de marcas.ts (única fuente de verdad,
// compartida con /proveedores/) en vez de mantener una segunda lista a mano que
// podría desincronizarse.
const categorias = categoriasBase.map((cat) => ({
  ...cat,
  marcas: todasLasMarcas.filter((m) => m.categorias?.includes(cat.id)).map((m) => m.nombre),
}));
---

<BaseLayout
  title="Productos"
  description="Todo lo que necesitas, por categorías. Estructura y obra, acabados, decoración y pintura, fontanería y climatización, jardín y exterior."
  headerVariant="solid"
  active="productos"
>
  <section class="page-banner page-banner--photo" style={`--banner-photo:url(${withBase('/images/matalmacen.jpg')})`}>
    <div class="wrap">
      <div class="breadcrumb"><a href={withBase('/')}>Inicio</a> · Productos</div>
      <h1>Todo lo que necesitas, por categorías. Sin vueltas.</h1>
      <p>Cinco categorías, un mismo asesoramiento honesto en cada una.</p>
    </div>
  </section>

  <section style="background:var(--sand);">
    <div class="wrap">
      <div class="eyebrow-sm">Catálogo por categoría</div>
      <h2>Encuentra tu categoría</h2>
      <p class="section-sub">Trabajamos con primeras marcas. Si no lo tenemos en tienda, te decimos cuándo puede estar disponible. <a href={withBase('/proveedores/')} style="color:var(--green-deep); font-weight:600; text-decoration:underline;">Ver todos los proveedores →</a></p>
      <div class="product-search-bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="product-search" type="search" placeholder="Busca un producto, marca o incluso la zona de tu casa…" aria-label="Buscar producto, marca o zona de la casa">
      </div>
      <div class="product-search-examples">
        {['azulejo', 'baño', 'cemento', 'jardín', 'pintura', 'grifería'].map((ej) => (
          <button type="button" class="product-chip" data-example={ej}>{ej}</button>
        ))}
      </div>
      <p id="product-search-empty" role="status" hidden style="margin-top:-14px; margin-bottom:32px; font-size:13.5px; color:#6b6c64;">No encontramos nada con ese término — prueba con otra palabra, o <a href="https://wa.me/34607224454" style="color:var(--green-dark); font-weight:600;">pregúntanos por WhatsApp</a>.</p>

      <div class="grid" style="gap:24px;">
        {categorias.map((cat) => (
          <div class="card product-category-card" id={cat.id} data-cat-name={cat.nombre} data-cat-marcas={(cat.marcas ?? []).join(' ')} data-cat-zonas={cat.zonas.join(' ')} style="padding:34px 32px;">
            <div class="grid grid-2" style="gap:32px; align-items:start;">
              <div>
                <span class="tag">Categoría</span>
                <h3>{cat.nombre}</h3>
                <p>{cat.desc}</p>
                {cat.marcas.length > 0 && (
                  <p class="category-brands"><strong>Marcas:</strong> {cat.marcas.join(' · ')}</p>
                )}
                <div style="margin-top:20px;">
                  <a href={withBase(`/contacto/?categoria=${encodeURIComponent(cat.nombre)}`)} class="btn-outline" style="padding:14px 18px; font-size:13.5px;">Consultar disponibilidad →</a>
                </div>
              </div>
              <div class="product-chips">
                {cat.productos.map((p) => <span class="product-chip">{p}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band" style="background:var(--ink);">
        <h3>¿No encuentras lo que buscas? Pregúntanos directamente: conocemos el catálogo mejor que cualquier buscador.</h3>
        <a href="https://wa.me/34607224454" class="btn-primary">Escribir por WhatsApp →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Barra de búsqueda en píldora, no campo de formulario: esto filtra una
     lista, no envía nada, así que sigue el lenguaje visual de botones/tags
     del sitio (bordes muy redondeados) en vez del de los inputs de
     Contacto/Empleo (esquinas de 10px, etiqueta encima). */
  .product-search-bar{ display:flex; align-items:center; gap:12px; background:var(--cream-card); border:1px solid var(--line); border-radius:999px; padding:14px 22px; max-width:520px; margin-bottom:14px; }
  .product-search-bar svg{ flex:0 0 auto; color:#8a8b83; }
  .product-search-bar input{ flex:1 1 auto; min-width:0; border:none; outline:none; background:none; font-family:inherit; font-size:14.5px; color:var(--ink); }
  .product-search-bar input::placeholder{ color:#8a8b83; }
  .product-search-bar:focus-within{ border-color:var(--green); }

  .product-search-examples{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:32px; }
  .product-search-examples .product-chip{ cursor:pointer; transition:border-color .15s ease, background .15s ease, color .15s ease; }
  .product-search-examples .product-chip:hover{ border-color:var(--green); }
  .product-search-examples .product-chip.is-active{ background:var(--ink); border-color:var(--ink); color:#fff; }
</style>

<script>
  // Buscador de productos: filtra en el propio navegador sobre el catálogo
  // ya existente (nombre de producto, categoría o marca), sin backend ni
  // base de datos — no hay tantos productos como para necesitar más.
  // Ignora acentos al comparar para que "climatizacion" encuentre
  // "climatización".
  function normalize(value: string): string {
    return value
      .toLowerCase()
      .replace(/[áàäâ]/g, 'a')
      .replace(/[éèëê]/g, 'e')
      .replace(/[íìïî]/g, 'i')
      .replace(/[óòöô]/g, 'o')
      .replace(/[úùüû]/g, 'u')
      .replace(/ñ/g, 'n');
  }

  const searchInput = document.getElementById('product-search') as HTMLInputElement | null;
  const emptyMsg = document.getElementById('product-search-empty');
  const categoryCards = document.querySelectorAll<HTMLElement>('.product-category-card');
  const exampleButtons = document.querySelectorAll<HTMLButtonElement>('[data-example]');

  function applyFilter(rawQuery: string) {
    const q = normalize(rawQuery.trim());
    let anyVisible = false;

    categoryCards.forEach((card) => {
      const catMatch = q === '' || normalize(card.dataset.catName ?? '').includes(q) || normalize(card.dataset.catMarcas ?? '').includes(q) || normalize(card.dataset.catZonas ?? '').includes(q);
      const chips = card.querySelectorAll<HTMLElement>('.product-chip');
      let chipMatchAny = false;

      chips.forEach((chip) => {
        // Si la categoría entera coincide (por nombre o marca), se muestran
        // todos sus productos aunque ninguno contenga el texto buscado —
        // p. ej. buscar "Pladur" también debe enseñar el resto de
        // Estructura y Obra, no solo las dos líneas de Pladur.
        const match = q === '' || catMatch || normalize(chip.textContent ?? '').includes(q);
        chip.style.display = match ? '' : 'none';
        if (match) chipMatchAny = true;
      });

      const show = q === '' || catMatch || chipMatchAny;
      card.style.display = show ? '' : 'none';
      if (show) anyVisible = true;
    });

    if (emptyMsg) emptyMsg.hidden = q === '' || anyVisible;

    // Resalta el chip de ejemplo que coincide con el texto actual, tanto si
    // se llegó a él con un clic como si se escribió el mismo término a mano.
    exampleButtons.forEach((btn) => {
      btn.classList.toggle('is-active', q !== '' && normalize(btn.dataset.example ?? '') === q);
    });
  }

  searchInput?.addEventListener('input', () => applyFilter(searchInput.value));

  exampleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = btn.dataset.example ?? '';
      applyFilter(searchInput.value);
      searchInput.focus();
    });
  });
</script>
