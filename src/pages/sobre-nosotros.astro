---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

// Sección "Quién te atiende": empieza a rellenarse con gente real (Carlos,
// transportista) en vez de los ejemplos anteriores (Ana/Javier/Marta). Se
// reactiva ya con esta primera entrada real; se irá ampliando según lleguen
// más fotos del resto del equipo.
const showTeamSection = true;
---

<BaseLayout
  title="Sobre nosotros"
  description="Detrás de Construdepot hay un equipo, no solo un almacén. Materiales de construcción con nombre y cara conocida en Elche."
  headerVariant="solid"
  active="sobre-nosotros"
>
  <section class="page-banner page-banner--photo" style={`--banner-photo:url(${withBase('/images/entrada2.webp')})`}>
    <div class="wrap">
      <div class="breadcrumb"><a href={withBase('/')}>Inicio</a> · Sobre nosotros</div>
      <h1>Detrás de Construdepot hay un equipo, no solo un almacén</h1>
      <p>Materiales de construcción con nombre y cara conocida en Elche.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow-sm">Nuestra historia</div>
      <h2>Cómo empezamos</h2>
      <p class="section-sub placeholder-text">Aquí contaremos cómo empezó Construdepot: el año, quién lo puso en marcha y qué le impulsó a hacerlo.</p>
      <p class="placeholder-text" style="max-width:600px; margin-bottom:16px;">Un segundo párrafo explicará cómo ha crecido el negocio con los años: qué ha cambiado, qué se ha ampliado, cómo ha evolucionado el trato con particulares y profesionales.</p>
      <p class="placeholder-text" style="max-width:600px; margin-bottom:16px;">Y un tercero cerrará con lo que se mantiene igual pese al crecimiento: el trato cercano, el compromiso con Elche, la forma de trabajar de siempre.</p>
      <span class="placeholder-note">✎ Texto de ejemplo, pendiente de historia real</span>
    </div>
  </section>

  <section style="background:var(--sand);">
    <div class="wrap">
      <div class="eyebrow-sm">Nuestro espacio</div>
      <h2>Exposición y almacén, de verdad</h2>
      <p class="section-sub">Fotos reales de la tienda en Elche, no de un catálogo. Esto es lo que te vas a encontrar.</p>

      <div class="photo-group">
        <h3 style="font-size:16px; margin:28px 0 4px;">Exposición</h3>
        <p style="font-size:13.5px; color:#6b6c64; margin-bottom:0;">Una amplia exposición para poder reformar tu vivienda, baño, cocina…</p>
        <div class="carousel-wrap">
          <button type="button" class="carousel-btn carousel-btn--prev" data-carousel-prev aria-label="Ver fotos anteriores de la exposición">‹</button>
          <div class="carousel" data-carousel>
            <img src={withBase('/images/intbaño4.jpg')} alt="Exposición de baños con mueble de madera, sanitarios y espejo redondo iluminado" loading="lazy" class="is-active" />
            <img src={withBase('/images/cocina.jpg')} alt="Exposición de cocina con isla de madera y grifería Gessi" loading="lazy" />
            <img src={withBase('/images/intazulejos.jpg')} alt="Pared de muestras de azulejo y pavimento de varias marcas" loading="lazy" />
            <img src={withBase('/images/mamparas.jpg')} alt="Exposición de mamparas de ducha de varios acabados" loading="lazy" />
            <img src={withBase('/images/intbaño2.jpg')} alt="Baño de exposición con pared de piedra oscura y ducha con mampara" loading="lazy" />
            <img src={withBase('/images/grifos.jpg')} alt="Expositor de griferías y muestras de azulejo Keraben" loading="lazy" />
            <img src={withBase('/images/intbaño5.jpg')} alt="Baño de exposición con mueble en tonos madera y grifería dorada" loading="lazy" />
            <img src={withBase('/images/matint.jpg')} alt="Exposición de baños con doble lavabo en mármol y espejos ovalados" loading="lazy" />
          </div>
          <button type="button" class="carousel-btn carousel-btn--next" data-carousel-next aria-label="Ver más fotos de la exposición">›</button>
        </div>
      </div>

      <div class="photo-group">
        <h3 style="font-size:16px; margin:28px 0 4px;">Almacén</h3>
        <p style="font-size:13.5px; color:#6b6c64; margin-bottom:0;">Disponemos de un patio de 10.000 m² donde almacenamos todo tipo de producto para que puedas cargar palets completos de cualquier producto que puedas imaginar: vallas, fachadas, zócalos, jardines, cerramientos, etc.</p>
        <div class="carousel-wrap">
          <button type="button" class="carousel-btn carousel-btn--prev" data-carousel-prev aria-label="Ver fotos anteriores del almacén">‹</button>
          <div class="carousel" data-carousel>
            <img src={withBase('/images/matexterior.jpg')} alt="Patio exterior de 10.000 m² con palets de ladrillo y bloque listos para cargar" loading="lazy" class="is-active" />
            <img src={withBase('/images/matalmacen8.jpg')} alt="Nave de almacén con stock de placas de Pladur y Escayescos" loading="lazy" />
            <img src={withBase('/images/exteriorcargarapida.jpg')} alt="Fachada de Construdepot con zona de carga y descarga rápida" loading="lazy" />
            <img src={withBase('/images/matalmacen3.jpg')} alt="Nave de almacén con sacos de cemento y mortero apilados por color" loading="lazy" />
            <img src={withBase('/images/matalmacen5.jpg')} alt="Nave de almacén con palés de ladrillo cerámico bajo cartel de Ladrillos" loading="lazy" />
            <img src={withBase('/images/matexterior4.jpg')} alt="Patio exterior con bloques de hormigón apilados y palmera al fondo" loading="lazy" />
            <img src={withBase('/images/matalmacen2.jpg')} alt="Nave de almacén con perfilería y placas de Pladur en estanterías" loading="lazy" />
            <img src={withBase('/images/matalmacen9.jpg')} alt="Nave de almacén con estanterías de picking y pasillo central" loading="lazy" />
          </div>
          <button type="button" class="carousel-btn carousel-btn--next" data-carousel-next aria-label="Ver más fotos del almacén">›</button>
        </div>
      </div>
    </div>
  </section>

  {/* Arena a propósito: "Nuestro espacio" (justo antes) también es arena.
      No hay forma de alternar perfectamente crema/arena aquí sin romper
      "El equipo" (crema, fijado así a petición expresa) — se absorbe el
      corte de la alternancia aquí en vez de ahí. */}
  <section style="background:var(--sand);">
    <div class="wrap">
      <div class="eyebrow-sm">Lo que nos define</div>
      <h2>Nuestros valores</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>Cercanía real</h3>
          <p>No somos una cadena. Conocemos a quien nos compra y le acompañamos en cada decisión, desde una baldosa hasta el suministro completo de una obra.</p>
        </div>
        <div class="card">
          <h3>Asesoramiento honesto</h3>
          <p>Te decimos lo que necesitas, no lo que nos interesa vender más. Si un material no es el adecuado para tu proyecto, te asesoramos para encontrarlo.</p>
        </div>
        <div class="card">
          <h3>Compromiso con Elche</h3>
          <p>Somos de aquí. Conocemos las obras de la zona y lo que necesita cada tipo de reforma.</p>
        </div>
      </div>
    </div>
  </section>

  {showTeamSection && (
  <section style="background:var(--cream);">
    <div class="wrap">
      <div class="eyebrow-sm">El equipo</div>
      <h2>Quién te atiende</h2>
      <p class="section-sub">Caras y nombres reales, para que sepas con quién hablas antes incluso de venir a la tienda.</p>
      <!--
        Avatares: ilustraciones estilo cómic generadas a partir de una foto real
        de cada persona (misma idea que los avatares "Avataaars" que se usaron
        al principio para Carlos/Juan/Julian: un dibujo que se le parece, sin
        publicar la foto original). Queda ampliar el equipo según lleguen más.
      -->
      <div class="team-grid">
        <div class="card">
          <div class="team-avatar team-avatar--1">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/paco.jpg')} alt="Paco" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Paco</h3>
          <p>Gerente. El jefe jefazo, la última palabra siempre es suya.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--2">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/pepe2.jpg')} alt="Pepe" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Pepe</h3>
          <p>Gerente. Coordina cada pedido para que salga a tiempo.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--3">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/ache.jpg')} alt="Ache" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Ache</h3>
          <p>Operador de logística y comercial. Responsable del stock de almacén y un todoterreno con los clientes, habla árabe perfectamente.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--4">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/alicia.jpg')} alt="Alicia" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Alicia</h3>
          <p>Administración y contabilidad. El mejor equipo llevando las cuentas al día.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--5">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/carlos.jpg')} alt="Carlos" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Carlos</h3>
          <p>Transportista. Lleva el material hasta donde otros no llegan.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--1">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/juan.jpg')} alt="Juan" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Juan</h3>
          <p>Operador de almacén. Tu mercancía sale mejor ubicada y protegida que en tu propia casa.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--2">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/julian.jpg')} alt="Julian" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Julian</h3>
          <p>Responsable de cargas del almacén. El que más kilómetros hace encima de un torito.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--3">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/pepe.jpg')} alt="Pepe" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Pepe</h3>
          <p>Informático y experto en IA. Si algo falla en la web, ya lo ha arreglado antes de que te enteres.</p>
        </div>
        <div class="card">
          <div class="team-avatar team-avatar--4">
            <div class="team-avatar-float">
              <img src={withBase('/images/avatares/tania.jpg')} alt="Tania" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" />
            </div>
          </div>
          <span class="tag">Equipo</span>
          <h3>Tania</h3>
          <p>Comercial. La más simpática del equipo, resuelve cualquier duda antes de que termines de preguntarla.</p>
        </div>
      </div>
    </div>
  </section>
  )}

  <section style="background:var(--sand);">
    <div class="wrap">
      <div class="cta-band">
        <h3>¿Tienes un proyecto entre manos? Ven a vernos o escríbenos, te asesoramos sin compromiso.</h3>
        <a href={withBase('/contacto/')} class="btn-primary">Consultar disponibilidad →</a>
      </div>
    </div>
  </section>

  <div class="lightbox" data-lightbox hidden>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Cerrar">✕</button>
    <button type="button" class="lightbox-nav lightbox-nav--prev" data-lightbox-prev aria-label="Foto anterior">‹</button>
    <img data-lightbox-img alt="" />
    <button type="button" class="lightbox-nav lightbox-nav--next" data-lightbox-next aria-label="Foto siguiente">›</button>
  </div>
</BaseLayout>

<script>
  // Carruseles de "Nuestro espacio": foto activa centrada a tamaño completo,
  // con la anterior/siguiente asomando a los lados (scroll-snap nativo).
  // Avanza sola cada 4s (bucle infinito, misma idea que .brand-marquee) y se
  // detiene al poner el cursor encima, al enfocar algo dentro con teclado, o
  // mientras el lightbox está abierto encima. Los botones también funcionan
  // y reinician el temporizador para no pelear con el avance automático.
  const AUTO_ADVANCE_MS = 4000;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tracks = document.querySelectorAll<HTMLElement>('[data-carousel]');
  const autoplayControls: { stop: () => void; start: () => void }[] = [];
  // Mientras el lightbox está abierto, ningún carrusel de fondo debe
  // rearrancar su auto-avance — ni siquiera cuando el ratón lo abandona
  // camino de los controles del lightbox (dispara mouseleave igualmente).
  let lightboxIsOpen = false;

  tracks.forEach((track) => {
    const wrap = track.closest('.carousel-wrap');
    const prevBtn = wrap?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextBtn = wrap?.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const slides = Array.from(track.querySelectorAll<HTMLImageElement>('img'));
    let index = Math.max(0, slides.findIndex((img) => img.classList.contains('is-active')));
    let timer: ReturnType<typeof setInterval> | undefined;
    let scrollRaf: number | undefined;

    // La foto "activa" (escala 1, opacidad 1) es la que está más cerca del
    // centro del carrusel en cada momento, tanto en reposo como a mitad de
    // un scroll — así las laterales se atenúan/agrandan de forma gradual.
    const markActive = () => {
      const trackRect = track.getBoundingClientRect();
      const center = trackRect.left + trackRect.width / 2;
      let closest = 0;
      let closestDist = Infinity;
      slides.forEach((img, n) => {
        const r = img.getBoundingClientRect();
        const dist = Math.abs((r.left + r.width / 2) - center);
        if (dist < closestDist) { closestDist = dist; closest = n; }
      });
      index = closest;
      slides.forEach((img, n) => img.classList.toggle('is-active', n === closest));
    };

    // scrollIntoView({block:'nearest'}) puede mover igualmente el scroll
    // vertical de la página si la foto no está del todo visible (p. ej. al
    // avanzar sola mientras el usuario está leyendo más abajo) — por eso se
    // calcula el scrollLeft a mano y solo se mueve el carrusel, nunca la
    // página.
    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      const slide = slides[index];
      const target = slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2;
      track.scrollTo({ left: target, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
    };
    const step = (dir: number) => show(index + dir);

    const start = () => {
      stop();
      // Ni el ratón ni el teclado deben reactivar el avance automático
      // mientras el lightbox tapa el carrusel.
      if (prefersReducedMotion || lightboxIsOpen) return;
      timer = setInterval(() => step(1), AUTO_ADVANCE_MS);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
    };
    autoplayControls.push({ stop, start });

    prevBtn?.addEventListener('click', () => { step(-1); start(); });
    nextBtn?.addEventListener('click', () => { step(1); start(); });
    wrap?.addEventListener('mouseenter', stop);
    wrap?.addEventListener('mouseleave', start);
    // Un usuario de teclado que tabula hasta una flecha o una foto no debe
    // ver cómo el carrusel avanza solo debajo de su foco.
    wrap?.addEventListener('focusin', stop);
    wrap?.addEventListener('focusout', (e) => {
      if (!wrap.contains((e as FocusEvent).relatedTarget as Node)) start();
    });
    track.addEventListener('scroll', () => {
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
      scrollRaf = requestAnimationFrame(markActive);
    }, { passive: true });

    start();
  });

  // Lightbox: clic en cualquier foto de un carrusel la abre a tamaño grande,
  // con flechas para pasar a la siguiente/anterior sin cerrarla.
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  let currentImages: HTMLImageElement[] = [];
  let currentIndex = 0;

  const showImage = (index: number) => {
    if (!lightboxImg || currentImages.length === 0) return;
    currentIndex = (index + currentImages.length) % currentImages.length;
    const src = currentImages[currentIndex].currentSrc || currentImages[currentIndex].src;
    lightboxImg.src = src;
    lightboxImg.alt = currentImages[currentIndex].alt;
  };

  const openLightbox = (track: HTMLElement, img: HTMLImageElement) => {
    currentImages = Array.from(track.querySelectorAll('img'));
    showImage(currentImages.indexOf(img));
    lightbox?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
    // Con el lightbox encima, los carruseles de fondo no deben seguir
    // avanzando solos: al volver, la foto tiene que seguir donde estaba.
    // El flag evita que un mouseleave/focusout disparado por el propio
    // clic (el cursor sale del carrusel camino de los controles del
    // lightbox) los reactive por debajo mientras siguen tapados.
    lightboxIsOpen = true;
    autoplayControls.forEach((c) => c.stop());
  };

  const closeLightbox = () => {
    lightbox?.setAttribute('hidden', '');
    document.body.style.overflow = '';
    lightboxIsOpen = false;
    autoplayControls.forEach((c) => c.start());
  };

  tracks.forEach((track) => {
    track.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
      img.style.cursor = 'zoom-in';
      // Foco y activación por teclado (Enter/Espacio), no solo clic de
      // ratón: si no, quien navega con teclado no puede ver las fotos
      // en grande.
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Ver foto en grande: ${img.alt}`);
      img.addEventListener('click', () => openLightbox(track, img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(track, img);
        }
      });
    });
  });

  lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', closeLightbox);
  lightbox?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => showImage(currentIndex - 1));
  lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => showImage(currentIndex + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox?.hasAttribute('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>
