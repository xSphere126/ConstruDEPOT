---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureMark from '../components/SignatureMark.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o se ha movido."
  headerVariant="solid"
>
  <section class="page-banner">
    <SignatureMark class="icon-wm" />
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Inicio</a> · Error 404</div>
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace esté roto o que la página se haya movido. Prueba desde aquí:</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-3">
        <a href="/" class="card" style="text-decoration:none;">
          <h3>Inicio</h3>
          <p>Vuelve a la página principal.</p>
        </a>
        <a href="/productos/" class="card" style="text-decoration:none;">
          <h3>Productos</h3>
          <p>Consulta el catálogo por categorías.</p>
        </a>
        <a href="/contacto/" class="card" style="text-decoration:none;">
          <h3>Contacto</h3>
          <p>Escríbenos o llámanos directamente.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
