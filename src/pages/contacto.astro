---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureMark from '../components/SignatureMark.astro';
import GatedEmbed from '../components/GatedEmbed.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID || '';
---

<BaseLayout
  title="Contacto"
  description="Estamos aquí para ayudarte. Elige cómo prefieres hablar con nosotros. WhatsApp, formulario, o ven a vernos a Elche."
  headerVariant="solid"
  active="contacto"
>
  <section class="page-banner">
    <SignatureMark class="icon-wm" />
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Inicio</a> · Contacto</div>
      <h1>Estamos aquí para ayudarte</h1>
      <p id="banner-sub">Elige cómo prefieres hablar con nosotros. Si eres profesional, mira las condiciones de suministro más abajo.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-2" style="align-items:start; gap:48px;">

        <div>
          <div class="eyebrow-sm">Formulario</div>
          <h2>Cuéntanos qué necesitas</h2>
          <form id="contactForm" data-formspree-id={formspreeId} style="display:flex; flex-direction:column; gap:16px; margin-top:20px;">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; left:-9999px;" />
            <div>
              <span class="field-label">¿Quién eres?</span>
              <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="button" class="btn-toggle" data-perfil="particular" aria-pressed="false">Particular</button>
                <button type="button" class="btn-toggle" data-perfil="profesional" aria-pressed="false">Profesional</button>
              </div>
              <input type="hidden" name="perfil" id="f-perfil" />
            </div>
            <div>
              <label class="field-label" for="f-nombre">Nombre</label>
              <input id="f-nombre" name="nombre" type="text" required placeholder="Tu nombre" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-telefono">Teléfono</label>
              <input id="f-telefono" name="telefono" type="tel" required placeholder="Tu teléfono" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-email">Email (opcional)</label>
              <input id="f-email" name="email" type="email" placeholder="Tu email" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-mensaje">¿Qué material o categoría te interesa?</label>
              <textarea id="f-mensaje" name="mensaje" placeholder="Cuéntanos qué necesitas" rows="4" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px; resize:vertical;"></textarea>
            </div>
            <button type="submit" class="btn-primary" style="justify-content:center;">Enviar consulta →</button>
            <p id="form-status" role="status" style="font-size:12.5px; color:#6b6c64;">Respondemos en el mismo día laborable. Para consultas urgentes, WhatsApp es más rápido que el formulario.</p>
            {!formspreeId && (
              <div class="pending">Falta crear una cuenta en formspree.io y poner el ID del formulario en <code>sitio/.env</code> como <code>PUBLIC_FORMSPREE_ID</code>. Mientras tanto, los envíos no llegan a ningún sitio.</div>
            )}
          </form>
        </div>

        <div>
          <div class="eyebrow-sm">Datos directos</div>
          <h2>O contáctanos ya</h2>
          <div class="card" style="margin-bottom:16px;">
            <h3>WhatsApp</h3>
            <p><a href="https://wa.me/34607224454" style="color:var(--green-dark); font-weight:600;">607 224 454</a>, la vía más rápida</p>
          </div>
          <div class="card" style="margin-bottom:16px;">
            <h3>Ubicación</h3>
            <p>N-340, Partida Jubalcoy, pol. 1, núm. 74 · 03295 Elche, Alicante</p>
          </div>
          <div class="card" style="margin-bottom:16px;">
            <h3>Horario</h3>
            <p>Lunes a sábado · 7:30–20:00h</p>
          </div>
          <div class="card">
            <h3>Teléfono fijo y email</h3>
            <p><a href="tel:+34965799179" style="color:var(--green-dark); font-weight:600;">965 79 91 79</a></p>
            <p style="margin-top:10px;"><a href="mailto:jquiless@quiles.es" style="color:var(--green-dark); font-weight:600;">jquiless@quiles.es</a></p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="profesionales" style="background:var(--sand);">
    <div class="wrap">
      <div class="eyebrow-sm">Para profesionales</div>
      <h2>Suministro para profesionales, sin esperas ni excusas</h2>
      <p class="section-sub">Tu obra no puede parar. Nosotros tampoco. Si eres contratista o autónomo, esto es lo que necesitas saber.</p>

      <div class="grid grid-3" style="margin-bottom:40px;">
        <div class="card">
          <h3>Suministro rápido</h3>
          <p>Pides hoy, lo tienes cuando lo necesitas. Sin depender de plazos de fabricante genéricos.</p>
        </div>
        <div class="card">
          <h3>Trato directo</h3>
          <p>Un contacto fijo para tus pedidos, no un formulario genérico que tarda días en responder.</p>
        </div>
        <div class="card">
          <h3>Materiales técnicos</h3>
          <p>Seleccionamos producto pensado para obra, no solo para reforma doméstica.</p>
        </div>
      </div>

      <div class="card" style="border-radius:20px; padding:8px 8px; margin-bottom:12px;">
        <table class="cond">
          <tr><th>Condición</th><th>Detalle</th></tr>
          <tr><td>Plazos de entrega</td><td class="placeholder-text">A concretar con el equipo</td></tr>
          <tr><td>Facturación</td><td class="placeholder-text">A concretar con el equipo</td></tr>
          <tr><td>Zona de reparto</td><td class="placeholder-text">A concretar con el equipo</td></tr>
          <tr><td>Contacto directo</td><td class="placeholder-text">A concretar con el equipo</td></tr>
        </table>
      </div>
      <span class="placeholder-note" style="margin-bottom:24px;">✎ Condiciones de ejemplo, pendientes de confirmar</span>

      <p class="section-sub" style="margin-bottom:0;">Ya trabajamos con contratistas y autónomos de Elche y alrededores. Si necesitas referencias, pregúntanos: usa el formulario de arriba y marca "Profesional".</p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap">
      <div class="eyebrow-sm">Cómo llegar</div>
      <h2>Mapa</h2>
      <div class="map-frame" style="height:340px;">
        <GatedEmbed category="maps" src="https://www.google.com/maps?q=Construdepot+by+Quiles,+N-340+Partida+Jubalcoy,+Elche,+Alicante&output=embed" title="Ubicación de Construdepot by Quiles en Elche" label="el mapa de Google" />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function selectPerfil(btn: HTMLButtonElement) {
    document.querySelectorAll<HTMLButtonElement>('.btn-toggle').forEach((b) => {
      b.classList.remove('is-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('is-active');
    btn.setAttribute('aria-pressed', 'true');

    const perfilField = document.getElementById('f-perfil') as HTMLInputElement | null;
    if (perfilField) perfilField.value = btn.dataset.perfil ?? '';

    if (btn.dataset.perfil === 'profesional') {
      document.getElementById('profesionales')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-toggle').forEach((btn) => {
    btn.addEventListener('click', () => selectPerfil(btn));
  });

  // Si se llega desde una categoría de Productos (ej. ?categoria=Fontanería), precargar el mensaje
  (function prefillFromCategoria() {
    const params = new URLSearchParams(window.location.search);
    const categoria = params.get('categoria');
    if (!categoria) return;

    const msg = document.getElementById('f-mensaje') as HTMLTextAreaElement | null;
    if (msg) {
      msg.value = 'Me interesa la categoría: ' + categoria + '. ';
      msg.focus();
    }
    const banner = document.getElementById('banner-sub');
    if (banner) {
      banner.textContent = 'Nos escribes por: ' + categoria + '. Rellena el formulario y te contactamos con disponibilidad.';
    }
  })();

  // Envío del formulario a Formspree (ver PUBLIC_FORMSPREE_ID en sitio/.env)
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formspreeId = form.dataset.formspreeId;
    if (!statusEl) return;

    if (!formspreeId) {
      statusEl.textContent = 'El formulario todavía no está conectado. Escríbenos por WhatsApp mientras tanto: 607 224 454.';
      return;
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    statusEl.textContent = 'Enviando…';

    try {
      const res = await fetch(`https://formspree.io/f/${formspreeId}`, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.reset();
        form.hidden = true;
        statusEl.textContent = 'Gracias, hemos recibido tu consulta. Te contactamos en breve. Si es urgente, escríbenos directamente por WhatsApp.';
      } else {
        statusEl.textContent = 'No hemos podido enviar tu consulta. Prueba de nuevo o escríbenos por WhatsApp: 607 224 454.';
      }
    } catch {
      statusEl.textContent = 'No hemos podido enviar tu consulta. Prueba de nuevo o escríbenos por WhatsApp: 607 224 454.';
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
