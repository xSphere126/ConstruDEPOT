---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { vacantes } from '../data/vacantes';

const hayVacantes = vacantes.length > 0;

// Cloudflare Turnstile (anti-bot): opcional a propósito, ver .env.example.
// Sin site key configurada, el widget simplemente no se muestra y el
// formulario sigue funcionando como hasta ahora (sin verificación).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<BaseLayout
  title="Empleo"
  description="Trabaja con nosotros en Construdepot by Quiles: vacantes abiertas en Elche y candidatura espontánea para futuras oportunidades."
  headerVariant="solid"
  active="empleo"
>
  <section class="page-banner page-banner--photo" style={`--banner-photo:url(${withBase('/images/matalmacen4.jpg')})`}>
    <div class="wrap">
      <div class="breadcrumb"><a href={withBase('/')}>Inicio</a> · Empleo</div>
      <h1>Construimos nuestro equipo contigo</h1>
      <p>En ConstruDepot seguimos creciendo y queremos contar con personas que quieran crecer con nosotros.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-2" style="align-items:center; gap:48px;">
        <div>
          <div class="eyebrow-sm">Trabaja con nosotros</div>
          <h2>Buscamos profesionales para estas áreas</h2>
          <p class="section-sub">Buscamos profesionales para incorporarse a las diferentes áreas de nuestra empresa:</p>
          <div class="product-chips" style="margin-bottom:28px;">
            <span class="product-chip">Almacén y logística</span>
            <span class="product-chip">Tienda y exposición</span>
            <span class="product-chip">Ventas y atención al cliente</span>
            <span class="product-chip">Administración</span>
          </div>
          <p class="section-sub" style="margin-bottom:0;">Si eres una persona responsable, trabajadora y con ganas de formar parte de un equipo dinámico, queremos conocerte.</p>
        </div>
        <div class="empleo-team-preview">
          <!-- Mismos avatares reales (ilustración a partir de foto real, con
               la camiseta de Construdepot) que ya presenta Sobre Nosotros —
               no se duplican los 9, solo una muestra que enlaza al equipo
               completo, para que esta sección no se sienta "vacía" de gente
               real detrás de las vacantes. -->
          <div class="empleo-team-avatars">
            <div class="team-avatar team-avatar--1"><div class="team-avatar-float"><img src={withBase('/images/avatares/tania.jpg')} alt="Tania" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" /></div></div>
            <div class="team-avatar team-avatar--2"><div class="team-avatar-float"><img src={withBase('/images/avatares/juan.jpg')} alt="Juan" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" /></div></div>
            <div class="team-avatar team-avatar--3"><div class="team-avatar-float"><img src={withBase('/images/avatares/julian.jpg')} alt="Julian" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" /></div></div>
            <div class="team-avatar team-avatar--4"><div class="team-avatar-float"><img src={withBase('/images/avatares/paco.jpg')} alt="Paco" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" /></div></div>
            <div class="team-avatar team-avatar--5"><div class="team-avatar-float"><img src={withBase('/images/avatares/carlos.jpg')} alt="Carlos" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:50%; display:block;" /></div></div>
          </div>
          <p class="section-sub" style="margin-bottom:10px;">Este es el equipo con el que trabajarías: caras y nombres reales, no una franquicia anónima.</p>
          <a href={withBase('/sobre-nosotros/#quien-te-atiende')} style="color:var(--green-dark); font-weight:600; font-size:14.5px;">Conoce a todo el equipo →</a>
        </div>
      </div>
    </div>
  </section>

  <section style="background:var(--sand);">
    <div class="wrap">
      <div class="eyebrow-sm">Posiciones abiertas</div>
      <h2>{hayVacantes ? 'Esto es lo que necesitamos ahora mismo' : 'Ahora mismo no hay posiciones abiertas'}</h2>
      <p class="section-sub">{hayVacantes ? 'Pulsa un puesto para ver el detalle y aplicar directamente desde ahí.' : 'Deja tu candidatura más abajo y la guardamos para cuando surja algo.'}</p>

      <div class="job-list">
        {vacantes.map((v) => (
          <div class="job-row">
            <button type="button" class="job-row-head" data-job-toggle aria-expanded="false" aria-controls={`panel-${v.id}`}>
              <span class="job-row-title">{v.titulo}</span>
              <span class="job-row-tags">
                {v.ubicacion}
                {v.etiqueta && <span class="tag" style="margin-bottom:0;">{v.etiqueta}</span>}
              </span>
              <span class="job-row-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </button>
            <div class="job-row-panel" id={`panel-${v.id}`} data-job-panel hidden>
              <p>{v.descripcion}</p>
              {v.requisitos && v.requisitos.length > 0 && (
                <ul class="job-requisitos">
                  {v.requisitos.map((r) => <li>{r}</li>)}
                </ul>
              )}
              <button type="button" class="btn-primary" data-aplicar-vacante={v.titulo} data-aplicar-target={`panel-${v.id}`}>
                Aplicar a este puesto →
              </button>
              <div class="job-form-slot" data-form-slot></div>
            </div>
          </div>
        ))}
      </div>

      <div class="cta-band" style="margin-top:32px;" id="cta-espontanea">
        <div>
          <h3>¿Quieres formar parte de ConstruDepot?</h3>
          <p style="color:rgba(255,255,255,.8); font-size:14.5px; margin-top:10px; max-width:520px;">Aunque ahora mismo no haya ninguna vacante publicada que encaje con tu perfil, puedes enviarnos igualmente tu currículum. Valoraremos tu candidatura para futuras oportunidades dentro de la empresa.</p>
        </div>
        <button type="button" class="btn-primary" data-aplicar-vacante="Candidatura espontánea" data-aplicar-target="cta-espontanea">
          Enviar currículum →
        </button>
        <div class="job-form-slot" data-form-slot style="flex-basis:100%;"></div>
      </div>

      <p class="section-sub" style="margin-top:24px; margin-bottom:0;">¿Prefieres hablarlo antes de escribir? Llámanos o escríbenos por <a href="https://wa.me/34607224454" style="color:var(--green-dark); font-weight:600;">WhatsApp</a> al 607&nbsp;224&nbsp;454 o a <a href="mailto:info@construdepot.es" style="color:var(--green-dark); font-weight:600;">info@construdepot.es</a>.</p>

      <div id="formHome" hidden>
        <div id="applicationBlock">
          <div class="eyebrow-sm">Candidatura</div>
          <h3 style="font-family:'Roboto', sans-serif; font-size:19px; font-weight:600; margin-bottom:16px;">Tus datos</h3>
          <form id="empleoForm" data-action={withBase('/enviar-empleo.php')} style="display:flex; flex-direction:column; gap:16px;" enctype="multipart/form-data">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute; left:-9999px;" />
            <input type="hidden" id="f-puesto" name="puesto" value="" />
            <div>
              <label class="field-label" for="f-nombre">Nombre</label>
              <input id="f-nombre" name="nombre" type="text" required placeholder="Tu nombre" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-telefono">Teléfono</label>
              <input id="f-telefono" name="telefono" type="tel" required placeholder="Tu teléfono" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-email">Email</label>
              <input id="f-email" name="email" type="email" required placeholder="Tu email" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px;">
            </div>
            <div>
              <label class="field-label" for="f-mensaje">Tu experiencia o qué buscas</label>
              <textarea id="f-mensaje" name="mensaje" required placeholder="Cuéntanos tu experiencia o qué tipo de puesto buscas" rows="4" style="width:100%; margin-top:6px; padding:14px 16px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:14.5px; resize:vertical;"></textarea>
            </div>
            <div>
              <label class="field-label" for="f-cv">CV (PDF, opcional)</label>
              <input id="f-cv" name="cv" type="file" accept=".pdf,application/pdf" style="width:100%; margin-top:6px; padding:12px 14px; border-radius:10px; border:1px solid var(--line); font-family:inherit; font-size:13.5px; background:#fff;">
              <span style="display:block; font-size:12px; color:#6b6c64; margin-top:6px;">Máximo 2&nbsp;MB. Si no lo tienes, el mensaje de arriba ya nos vale.</span>
            </div>
            <label style="display:flex; align-items:flex-start; gap:10px; font-size:12.5px; color:var(--graphite); line-height:1.5;">
              <input type="checkbox" name="consentimiento" value="1" required style="margin-top:3px;">
              <span>He leído y acepto la <a href={withBase('/politica-privacidad/')} style="color:var(--green-dark); font-weight:600;">política de privacidad</a>, y autorizo el tratamiento de mis datos para este proceso de selección.</span>
            </label>
            {turnstileSiteKey && <div id="turnstileWidget" data-sitekey={turnstileSiteKey}></div>}
            <button type="submit" class="btn-primary" style="justify-content:center;">Enviar candidatura →</button>
          </form>
          {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>}
          <!-- Fuera del <form> a propósito, igual que en contacto.astro: al
               enviar con éxito se oculta todo el formulario y este mensaje
               necesita seguir visible para mostrar la confirmación. -->
          <p id="form-status" role="status" style="font-size:12.5px; color:var(--graphite); margin-top:16px;">Revisamos las candidaturas y contactamos si encaja con alguna vacante.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .empleo-team-avatars{ display:flex; flex-wrap:wrap; gap:14px; margin-bottom:18px; }

  .job-list{ display:flex; flex-direction:column; gap:14px; }
  .job-row{ background:var(--cream-card); border:1px solid var(--line); border-radius:16px; overflow:hidden; }
  /* Fila en columna a propósito: título y metadatos apilados verticalmente,
     con el chevron anclado en la esquina en vez de repartir el contenido en
     una barra horizontal (icono | texto | flecha). Con 3+ vacantes en fila
     esa barra horizontal se sentía más como una tabla que como un listado
     de ofertas. */
  .job-row-head{ width:100%; display:flex; flex-direction:column; align-items:flex-start; gap:5px; padding:20px 46px 20px 22px; background:none; border:none; cursor:pointer; text-align:left; font-family:inherit; position:relative; }
  .job-row-title{ font-family:'Roboto', sans-serif; font-weight:600; font-size:16.5px; color:var(--ink); }
  .job-row-tags{ font-size:13px; color:#6b6c64; display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
  .job-row-chevron{ position:absolute; top:22px; right:22px; color:#6b6c64; transition:transform .2s ease; display:flex; }
  .job-row-head[aria-expanded="true"] .job-row-chevron{ transform:rotate(180deg); }
  .job-row-panel{ padding:0 22px 26px; }
  .job-row-panel p{ font-size:14.5px; color:#5a5b54; line-height:1.6; margin-bottom:14px; max-width:640px; }
  .job-requisitos{ list-style:none; padding:0; margin:0 0 20px; display:flex; flex-direction:column; gap:8px; max-width:520px; }
  .job-requisitos li{ font-size:13.5px; color:#4b4c46; padding-left:22px; position:relative; }
  .job-requisitos li::before{ content:'✓'; position:absolute; left:0; color:var(--green-dark); font-weight:700; }
  .job-form-slot:not(:empty){ margin-top:24px; padding-top:24px; border-top:1px solid var(--line); }

  /* El bloque de candidatura está pensado para fondos claros (etiquetas y
     texto de consentimiento en tonos grafito) — dentro del cta-band, de
     fondo oscuro, necesita su propia "isla" clara en vez de heredar el
     fondo oscuro directamente, o el texto quedaría ilegible. */
  #cta-espontanea .job-form-slot:not(:empty){ margin-top:24px; padding:26px 24px; border-top:none; background:var(--cream-card); border-radius:16px; }
</style>

<script>
  // Acordeón de posiciones: una sola fila abierta a la vez, para no llenar
  // la página de paneles abiertos con 3+ vacantes. Si la fila que se cierra
  // contenía el bloque de candidatura (porque el visitante lo había abierto
  // ahí), se devuelve a su "casa" oculta en vez de dejarlo atrapado dentro
  // de un panel colapsado.
  const applicationBlock = document.getElementById('applicationBlock');
  const formHome = document.getElementById('formHome');
  const jobToggles = document.querySelectorAll<HTMLButtonElement>('[data-job-toggle]');

  jobToggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';

      jobToggles.forEach((other) => {
        if (other === toggle) return;
        other.setAttribute('aria-expanded', 'false');
        const otherPanel = document.getElementById(other.getAttribute('aria-controls') ?? '');
        if (!otherPanel) return;
        otherPanel.hidden = true;
        if (applicationBlock && formHome && otherPanel.contains(applicationBlock)) {
          formHome.appendChild(applicationBlock);
        }
      });

      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (panel) panel.hidden = isOpen;
    });
  });

  // Envío del formulario a enviar-empleo.php (mismo backend Graph que
  // contacto, con adjunto de CV). Validación de tamaño/tipo de CV también en
  // cliente para dar feedback inmediato, aunque el servidor la repite.
  const MAX_CV_BYTES = 2 * 1024 * 1024;
  const form = document.getElementById('empleoForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const DEFAULT_STATUS = 'Revisamos las candidaturas y contactamos si encaja con alguna vacante.';

  // El widget de Turnstile se pinta a propósito con render "explicit" (no
  // automático) y solo cuando se pulsa "Aplicar", no al cargar la página:
  // el formulario (y el widget dentro) empieza oculto dentro de #formHome,
  // y Cloudflare no inicializa bien un widget que todavía está oculto en
  // ese momento — de ahí que en Contacto (formulario siempre visible)
  // funcionara a la primera y aquí no. Se reintenta unas cuantas veces por
  // si el script de Cloudflare (con `defer`) aún no ha terminado de cargar
  // en el primer click.
  declare global {
    interface Window {
      turnstile?: {
        render: (container: string | HTMLElement, options: { sitekey: string }) => string;
      };
    }
  }
  let turnstileWidgetId: string | null = null;
  function ensureTurnstileRendered(retries = 20) {
    const container = document.getElementById('turnstileWidget');
    if (!container || turnstileWidgetId !== null) return;
    if (!window.turnstile) {
      if (retries > 0) setTimeout(() => ensureTurnstileRendered(retries - 1), 150);
      return;
    }
    const sitekey = container.dataset.sitekey;
    if (!sitekey) return;
    turnstileWidgetId = window.turnstile.render(container, { sitekey });
  }

  // Botón "Aplicar a este puesto"/"Enviar currículum": mueve el bloque de
  // candidatura (formulario + mensaje de estado, como una sola unidad) al
  // hueco de la vacante pulsada, y precarga el campo oculto "puesto" — así
  // hay un único formulario en toda la página, no uno por vacante. También
  // fuerza form.hidden = false y restaura el mensaje por defecto: sin esto,
  // si alguien ya había enviado una candidatura y pulsaba "Aplicar" en OTRA
  // vacante distinta, el formulario se movía ahí pero seguía oculto (el
  // envío anterior lo había dejado así) y no se veía nada.
  document.querySelectorAll<HTMLButtonElement>('[data-aplicar-vacante]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetPanel = document.getElementById(btn.dataset.aplicarTarget ?? '');
      const slot = targetPanel?.querySelector<HTMLElement>('[data-form-slot]');
      const puestoField = document.getElementById('f-puesto') as HTMLInputElement | null;
      if (!applicationBlock || !slot || !form || !statusEl) return;

      if (puestoField) puestoField.value = btn.dataset.aplicarVacante ?? '';
      slot.appendChild(applicationBlock);
      form.hidden = false;
      statusEl.textContent = DEFAULT_STATUS;
      ensureTurnstileRendered();
      applicationBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.getElementById('f-nombre')?.focus();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusEl) return;

    const action = form.dataset.action;
    if (!action) return;

    const cvInput = form.querySelector<HTMLInputElement>('#f-cv');
    const cvFile = cvInput?.files?.[0];
    if (cvFile) {
      if (cvFile.type !== 'application/pdf') {
        statusEl.textContent = 'El CV debe ser un archivo PDF.';
        return;
      }
      if (cvFile.size > MAX_CV_BYTES) {
        statusEl.textContent = 'El CV pesa demasiado (máximo 2 MB).';
        return;
      }
    }

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    statusEl.textContent = 'Enviando…';

    try {
      const res = await fetch(action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => null);

      if (res.ok && data?.ok) {
        form.reset();
        form.hidden = true;
        statusEl.textContent = 'Gracias, hemos recibido tu candidatura. Te contactamos si encaja con alguna vacante.';
      } else {
        const motivo = data?.message || 'No hemos podido enviar tu candidatura.';
        statusEl.textContent = `${motivo} Si el problema continúa, escríbenos por WhatsApp: 607 224 454.`;
      }
    } catch {
      statusEl.textContent = 'No hemos podido enviar tu candidatura. Prueba de nuevo o escríbenos por WhatsApp: 607 224 454.';
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
