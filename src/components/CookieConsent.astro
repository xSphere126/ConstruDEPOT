---
---

<div id="cookieBanner" class="cookie-banner" hidden>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="9.5" r="1"/><circle cx="14" cy="8.5" r="1"/><circle cx="15.5" cy="13" r="1"/><circle cx="10" cy="14.5" r="1"/><circle cx="13" cy="16.5" r="1"/></svg>
    </div>
    <div class="cookie-banner-text">
      <p class="cookie-banner-title">Tu privacidad</p>
      <p>
        Usamos cookies técnicas necesarias para el funcionamiento de la web. Con tu permiso, también
        cargamos contenido de terceros (mapa y feed de Instagram) que usa sus propias cookies. <a href="/politica-cookies/">Más información</a>.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" id="cookieRejectAll" class="btn-outline">Rechazar</button>
      <button type="button" id="cookieAcceptAll" class="btn-primary">Aceptar todas</button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'construdepot_cookie_consent';
  const banner = document.getElementById('cookieBanner');

  interface Consent {
    necessary: true;
    thirdParty: boolean;
    ts: number;
  }

  function getConsent(): Consent | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Consent) : null;
    } catch {
      return null;
    }
  }

  function setConsent(thirdParty: boolean): Consent {
    const value: Consent = { necessary: true, thirdParty, ts: Date.now() };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    return value;
  }

  function loadEmbed(el: Element) {
    const src = el.getAttribute('data-src');
    const title = el.getAttribute('data-title');
    if (!src || el.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    if (title) iframe.title = title;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.style.border = '0';
    el.innerHTML = '';
    el.appendChild(iframe);
  }

  function activateGatedEmbeds() {
    const consent = getConsent();
    if (!consent?.thirdParty) return;
    document.querySelectorAll('[data-gated-embed]').forEach(loadEmbed);
  }

  // El banner es position:fixed anclado abajo, así que cuando el visitante llega
  // al final de la página (footer) mientras el banner sigue visible, lo tapa
  // por completo — en móvil el banner puede ocupar ~300px, suficiente para
  // cubrir todo el footer. Reservamos ese espacio en el documento mientras el
  // banner esté visible para que el footer nunca quede inalcanzable.
  function syncBodyPadding() {
    if (banner && !banner.hidden) {
      document.body.style.paddingBottom = `${banner.offsetHeight}px`;
    } else {
      document.body.style.paddingBottom = '';
    }
  }

  function showBanner() {
    banner?.removeAttribute('hidden');
    syncBodyPadding();
  }

  function hideBanner() {
    banner?.setAttribute('hidden', '');
    syncBodyPadding();
  }

  window.addEventListener('resize', syncBodyPadding);

  document.querySelectorAll('.gated-embed-accept').forEach((btn) => {
    btn.addEventListener('click', () => {
      setConsent(true);
      const el = btn.closest('[data-gated-embed]');
      if (el) loadEmbed(el);
      hideBanner();
    });
  });

  document.getElementById('cookieAcceptAll')?.addEventListener('click', () => {
    setConsent(true);
    activateGatedEmbeds();
    hideBanner();
  });

  document.getElementById('cookieRejectAll')?.addEventListener('click', () => {
    setConsent(false);
    hideBanner();
  });

  document.querySelectorAll('[data-open-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      showBanner();
    });
  });

  const existing = getConsent();
  if (existing) {
    activateGatedEmbeds();
  } else {
    showBanner();
  }
</script>
