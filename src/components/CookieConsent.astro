---
import { withBase } from '../lib/url';
import { t } from '../i18n/useTranslations';
import type { Locale } from '../i18n/locales';

const locale = (Astro.currentLocale as Locale | undefined) ?? 'es';
const dict = t(locale).cookieBanner;
---

<div id="cookieBanner" class="cookie-banner" hidden>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-icon" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="9.5" r="1"/><circle cx="14" cy="8.5" r="1"/><circle cx="15.5" cy="13" r="1"/><circle cx="10" cy="14.5" r="1"/><circle cx="13" cy="16.5" r="1"/></svg>
    </div>
    <div class="cookie-banner-text">
      <p class="cookie-banner-title">{dict.title}</p>
      <p>
        {dict.descriptionBefore}<a href={withBase('/politica-cookies/')}>{dict.moreInfo}</a>.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" id="cookieRejectAll" class="btn-outline">{dict.reject}</button>
      <button type="button" id="cookieAcceptAll" class="btn-primary">{dict.acceptAll}</button>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'construdepot_cookie_consent';
  const banner = document.getElementById('cookieBanner');

  interface Consent {
    necessary: true;
    thirdParty: boolean;
    // Overrides por categoría (p. ej. { maps: true }) — permiten aceptar UN
    // elemento concreto (ver .gated-embed-accept más abajo) sin que eso
    // desbloquee el resto de contenido de terceros del sitio, tal como
    // promete la política de cookies ("sin afectar al resto").
    categories: Record<string, boolean>;
    ts: number;
  }

  // Un valor guardado con una forma inesperada (p. ej. "categories" como
  // texto o array en vez de objeto — probado a propósito escribiendo
  // valores manipulados en localStorage) no debe romper el resto del
  // script: categoryAllowed() usa el operador "in", que lanza una
  // excepción si se le pasa algo que no sea un objeto de verdad.
  function isPlainObject(value: unknown): value is Record<string, boolean> {
    return typeof value === 'object' && value !== null && !Array.isArray(value);
  }

  function getConsent(): Consent | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<Consent>;
      return {
        necessary: true,
        thirdParty: parsed.thirdParty === true,
        categories: isPlainObject(parsed.categories) ? parsed.categories : {},
        ts: typeof parsed.ts === 'number' ? parsed.ts : Date.now(),
      };
    } catch {
      return null;
    }
  }

  // Usado por "Aceptar todas" / "Rechazar": es una decisión general, así que
  // sustituye cualquier override de categoría anterior en vez de sumarse a él.
  function setConsent(thirdParty: boolean): Consent {
    const value: Consent = { necessary: true, thirdParty, categories: {}, ts: Date.now() };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    return value;
  }

  // Usado por el botón "Aceptar y mostrar" de un elemento concreto: solo
  // añade un override para ESA categoría, conservando el resto tal cual
  // estaba (incluida la preferencia general del banner principal).
  function setCategoryConsent(category: string): Consent {
    const existing = getConsent();
    const value: Consent = {
      necessary: true,
      thirdParty: existing?.thirdParty ?? false,
      categories: { ...(existing?.categories ?? {}), [category]: true },
      ts: Date.now(),
    };
    localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    return value;
  }

  function categoryAllowed(consent: Consent, category: string): boolean {
    return category in consent.categories ? consent.categories[category] : consent.thirdParty;
  }

  function loadEmbed(el: HTMLElement) {
    const src = el.getAttribute('data-src');
    const title = el.getAttribute('data-title');
    if (!src || el.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    if (title) iframe.title = title;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.style.border = '0';
    // SnapWidget necesita esta clase exacta para que su propio script sepa
    // qué iframes redimensionar según el contenido real — sin ella, el grid
    // se queda con la altura que le pongamos a mano, que nunca coincide entre
    // el layout de escritorio y el de móvil (número de filas distinto).
    const isSnapWidget = src.includes('snapwidget.com');
    if (isSnapWidget) {
      iframe.className = 'snapwidget-widget';
      iframe.scrolling = 'no';
    }
    // El placeholder se OCULTA, no se destruye (a diferencia de antes, que
    // vaciaba el contenedor con innerHTML=''): así unloadEmbed() más abajo
    // puede devolver el aviso original con su botón intacto si el visitante
    // retira el consentimiento después, sin tener que reconstruirlo a mano
    // ni volver a engancharle el listener de clic.
    const placeholder = el.querySelector<HTMLElement>('.gated-embed-placeholder');
    if (placeholder) placeholder.hidden = true;
    el.appendChild(iframe);

    // El script de SnapWidget solo busca iframes ".snapwidget-widget" que
    // YA existan en la página en el momento en que él mismo se carga — si se
    // cargara de entrada en el <head>, no encontraría este iframe porque
    // este bloque de consentimiento de cookies lo crea más tarde (justo lo
    // que hace, a propósito). Por eso el script se inyecta aquí mismo, justo
    // después de crear el iframe, para que cuando se ejecute el iframe ya
    // esté en el DOM y lo detecte a la primera. Guardado para no cargarlo
    // dos veces si hubiera más de un feed de SnapWidget en la página.
    if (isSnapWidget && !document.querySelector('script[data-snapwidget-loader]')) {
      const script = document.createElement('script');
      script.src = 'https://snapwidget.com/js/snapwidget.js';
      script.dataset.snapwidgetLoader = 'true';
      document.body.appendChild(script);
    }
  }

  // Contrario de loadEmbed(): quita el iframe activo y devuelve el aviso
  // original. Necesario para cuando alguien retira el consentimiento DESPUÉS
  // de haberlo dado (reabriendo "Configurar cookies" y pulsando "Rechazar")
  // en la misma visita — sin esto, el mapa o el feed de Instagram se quedaban
  // funcionando con normalidad pese al rechazo, hasta la siguiente carga de
  // página.
  function unloadEmbed(el: HTMLElement) {
    el.querySelector('iframe')?.remove();
    const placeholder = el.querySelector<HTMLElement>('.gated-embed-placeholder');
    if (placeholder) placeholder.hidden = false;
  }

  function activateGatedEmbeds() {
    const consent = getConsent();
    if (!consent) return;
    document.querySelectorAll<HTMLElement>('[data-gated-embed]').forEach((el) => {
      const category = el.getAttribute('data-category') ?? '';
      if (categoryAllowed(consent, category)) loadEmbed(el);
    });
  }

  function deactivateGatedEmbeds() {
    document.querySelectorAll<HTMLElement>('[data-gated-embed]').forEach(unloadEmbed);
  }

  // El banner es position:fixed anclado abajo, así que cuando el visitante llega
  // al final de la página (footer) mientras el banner sigue visible, lo tapa
  // por completo — en móvil el banner puede ocupar ~300px, suficiente para
  // cubrir todo el footer. Reservamos ese espacio en el documento mientras el
  // banner esté visible para que el footer nunca quede inalcanzable.
  function syncBodyPadding() {
    if (banner && !banner.hidden) {
      document.body.style.paddingBottom = `${banner.offsetHeight}px`;
    } else {
      document.body.style.paddingBottom = '';
    }
  }

  function showBanner() {
    banner?.removeAttribute('hidden');
    syncBodyPadding();
  }

  function hideBanner() {
    banner?.setAttribute('hidden', '');
    syncBodyPadding();
  }

  window.addEventListener('resize', syncBodyPadding);

  document.querySelectorAll('.gated-embed-accept').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn.closest<HTMLElement>('[data-gated-embed]');
      const category = el?.getAttribute('data-category') ?? '';
      setCategoryConsent(category);
      if (el) loadEmbed(el);
      hideBanner();
    });
  });

  document.getElementById('cookieAcceptAll')?.addEventListener('click', () => {
    setConsent(true);
    activateGatedEmbeds();
    hideBanner();
  });

  document.getElementById('cookieRejectAll')?.addEventListener('click', () => {
    setConsent(false);
    deactivateGatedEmbeds();
    hideBanner();
  });

  document.querySelectorAll('[data-open-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      showBanner();
    });
  });

  const existing = getConsent();
  if (existing) {
    activateGatedEmbeds();
  } else {
    showBanner();
  }
</script>
