---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, localizedHref } from '../i18n/useTranslations';
import type { Locale } from '../i18n/locales';
import type { PageKey } from '../i18n/pages';

interface Props {
  variant?: 'transparent' | 'solid';
  active?: 'inicio' | 'sobre-nosotros' | 'productos' | 'empleo' | 'contacto';
  pageKey?: PageKey;
}

const { variant = 'solid', active, pageKey = 'home' } = Astro.props;

const locale = (Astro.currentLocale as Locale | undefined) ?? 'es';
const dict = t(locale);

const navItems: { key: PageKey; navLabelKey: keyof typeof dict.nav; activeKey: NonNullable<Props['active']> }[] = [
  { key: 'home', navLabelKey: 'inicio', activeKey: 'inicio' },
  { key: 'sobre-nosotros', navLabelKey: 'sobre-nosotros', activeKey: 'sobre-nosotros' },
  { key: 'productos', navLabelKey: 'productos', activeKey: 'productos' },
  { key: 'empleo', navLabelKey: 'empleo', activeKey: 'empleo' },
  { key: 'contacto', navLabelKey: 'contacto', activeKey: 'contacto' },
];
---

<header class={variant === 'solid' ? 'solid' : undefined}>
  <div class="wrap">
    <div class={variant === 'transparent' ? 'logo-chip' : undefined}>
      {variant === 'transparent' ? (
        <>
          <div class="logo-mark logo-mark--chip">
            <Logo primaryFill="#FFFFFF" secondaryFill="#20211D" />
          </div>
          <div class="logo-mark logo-mark--pinned">
            <Logo />
          </div>
        </>
      ) : (
        <div class="logo-mark">
          <Logo />
        </div>
      )}
    </div>
    <nav class="mainnav">
      {navItems.map((item) => (
        <a href={localizedHref(item.key, locale)} class={active === item.activeKey ? 'active' : undefined}>
          {dict.nav[item.navLabelKey]}
        </a>
      ))}
    </nav>
    <div class="header-right">
      <div class="schedule-pill" data-label-almacen={dict.common.scheduleAlmacen} data-label-expo={dict.common.scheduleExpo} data-label-abierto={dict.common.scheduleAbierto} data-label-cerrado={dict.common.scheduleCerrado}>
        <span class="dot"></span> <span class="schedule-text"></span>
      </div>
      <LanguageSwitcher pageKey={pageKey} />
      <a href="tel:+34607224454" class="btn-call" aria-label={dict.common.call}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
      <a href="https://wa.me/34607224454" class="btn-whatsapp">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.5 0 9.96-4.46 9.96-9.96C22 6.46 17.54 2 12.04 2Zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.37-.5.07-1.02.1-3.27-.7-2.75-.98-4.53-3.76-4.67-3.94-.14-.18-1.12-1.49-1.12-2.84s.7-2.02.95-2.29c.24-.28.53-.34.7-.34h.5c.16 0 .38-.03.58.44.24.56.8 1.95.87 2.09.07.14.12.3.02.48-.09.18-.14.29-.28.45-.14.16-.29.36-.42.49-.14.14-.28.29-.12.56.16.28.7 1.16 1.51 1.88 1.04.93 1.92 1.22 2.2 1.36.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.81.86.26.14.44.2.5.32.07.12.07.68-.17 1.34Z"/></svg>
        607 224 454
      </a>
      <button type="button" class="btn-menu" id="menuToggle" aria-expanded="false" aria-controls="mobileMenu" data-label-open={dict.common.openMenu} data-label-close={dict.common.closeMenu} aria-label={dict.common.openMenu}>
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="icon-close is-hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
</header>

<!--
  El panel del menú móvil vive fuera de <header> a propósito: header.solid y
  header.header-pinned usan backdrop-filter, y backdrop-filter en un ancestro
  convierte a ese ancestro en el "containing block" de cualquier descendiente
  position:fixed — el panel quedaba atrapado dentro de los ~76px de alto del
  header en vez de cubrir la pantalla completa.
-->
<div class="mobile-menu" id="mobileMenu" hidden>
  <nav>
    {navItems.map((item) => (
      <a href={localizedHref(item.key, locale)} class={active === item.activeKey ? 'active' : undefined}>{dict.nav[item.navLabelKey]}</a>
    ))}
  </nav>
  <div class="mobile-menu-footer">
    <LanguageSwitcher pageKey={pageKey} />
    <div class="schedule-pill" data-label-almacen={dict.common.scheduleAlmacen} data-label-expo={dict.common.scheduleExpo} data-label-abierto={dict.common.scheduleAbierto} data-label-cerrado={dict.common.scheduleCerrado}>
      <span class="dot"></span> <span class="schedule-text"></span>
    </div>
    <a href="tel:+34607224454" class="btn-outline">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      607 224 454
    </a>
    <a href="https://wa.me/34607224454" class="btn-whatsapp">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.5 0 9.96-4.46 9.96-9.96C22 6.46 17.54 2 12.04 2Zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.37-.5.07-1.02.1-3.27-.7-2.75-.98-4.53-3.76-4.67-3.94-.14-.18-1.12-1.49-1.12-2.84s.7-2.02.95-2.29c.24-.28.53-.34.7-.34h.5c.16 0 .38-.03.58.44.24.56.8 1.95.87 2.09.07.14.12.3.02.48-.09.18-.14.29-.28.45-.14.16-.29.36-.42.49-.14.14-.28.29-.12.56.16.28.7 1.16 1.51 1.88 1.04.93 1.92 1.22 2.2 1.36.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.81.86.26.14.44.2.5.32.07.12.07.68-.17 1.34Z"/></svg>
      {dict.common.whatsappWrite}
    </a>
  </div>
</div>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const iconMenu = menuToggle?.querySelector('.icon-menu');
  const iconClose = menuToggle?.querySelector('.icon-close');

  // El panel de menú es una superposición a pantalla completa, pero el resto
  // de la página (main, footer) sigue en el DOM detrás — sin esto, un usuario
  // de teclado puede tabular más allá de los enlaces del menú y "perderse"
  // dentro de contenido visualmente tapado por el propio menú.
  function setBackgroundInert(isInert: boolean) {
    document.querySelectorAll('main, footer').forEach((el) => {
      if (isInert) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
  }

  function openMenu() {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.hidden = false;
    document.body.classList.add('menu-open');
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose ?? '');
    iconMenu?.classList.add('is-hidden');
    iconClose?.classList.remove('is-hidden');
    setBackgroundInert(true);
  }

  function closeMenu() {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.hidden = true;
    document.body.classList.remove('menu-open');
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen ?? '');
    iconClose?.classList.add('is-hidden');
    iconMenu?.classList.remove('is-hidden');
    setBackgroundInert(false);
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileMenu?.hidden) openMenu();
    else closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.hidden) {
      closeMenu();
      menuToggle?.focus();
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  window.addEventListener('resize', () => {
    if (window.innerWidth > 900 && mobileMenu && !mobileMenu.hidden) closeMenu();
  });

  // Estado de apertura real de la tienda. Se calcula contra la hora de Elche
  // (Europe/Madrid) siempre, no contra la hora local del dispositivo del
  // visitante — con new Date().getHours() un visitante con el reloj puesto en
  // otro huso horario (viajando, o con el dispositivo mal configurado) vería
  // "Abierto" o "Cerrado" según SU hora, no la de la tienda. Horario 2026 real
  // (flyer oficial de tienda): Almacén y Exposición tienen franjas distintas
  // entre semana, así que se calculan como dos áreas independientes en vez de
  // un único horario.
  function getMadridDayAndMinutes() {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Europe/Madrid',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());
    const map = Object.fromEntries(parts.map((p) => [p.type, p.value]));
    const weekdayIndex: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
    const day = weekdayIndex[map.weekday];
    const hour = parseInt(map.hour, 10) % 24; // medianoche puede venir como "24"
    const minute = parseInt(map.minute, 10);
    return { day, minutesNow: hour * 60 + minute };
  }

  function isAreaOpen(day: number, minutesNow: number, weekdayOpen: number, weekdayClose: number, satOpen: number, satClose: number) {
    if (day >= 1 && day <= 5) return minutesNow >= weekdayOpen && minutesNow < weekdayClose;
    if (day === 6) return minutesNow >= satOpen && minutesNow < satClose;
    return false; // domingo cerrado
  }

  function scheduleStatus() {
    const { day, minutesNow } = getMadridDayAndMinutes();
    const SAT_OPEN = 8 * 60 + 30;
    const SAT_CLOSE = 13 * 60 + 30;

    const almacenOpen = isAreaOpen(day, minutesNow, 7 * 60 + 30, 19 * 60, SAT_OPEN, SAT_CLOSE);
    const expoOpen = isAreaOpen(day, minutesNow, 9 * 60, 20 * 60, SAT_OPEN, SAT_CLOSE);

    return { almacenOpen, expoOpen };
  }

  // Las palabras (Almacén/Expo/Abierto/Cerrado) llegan como data-* en el
  // idioma activo desde Astro — este script no tiene ningún texto fijo en
  // español, funciona igual para cualquier idioma.
  function updateSchedulePills() {
    const { almacenOpen, expoOpen } = scheduleStatus();
    document.querySelectorAll<HTMLElement>('.schedule-pill').forEach((el) => {
      const textEl = el.querySelector('.schedule-text');
      const almacenLabel = el.dataset.labelAlmacen ?? '';
      const expoLabel = el.dataset.labelExpo ?? '';
      const abiertoLabel = el.dataset.labelAbierto ?? '';
      const cerradoLabel = el.dataset.labelCerrado ?? '';
      if (textEl) {
        textEl.textContent = `${almacenLabel}: ${almacenOpen ? abiertoLabel : cerradoLabel} · ${expoLabel}: ${expoOpen ? abiertoLabel : cerradoLabel}`;
      }
      el.querySelector('.dot')?.classList.toggle('dot-closed', !(almacenOpen || expoOpen));
    });
  }

  updateSchedulePills();
  setInterval(updateSchedulePills, 60000);

  // Cabecera transparente de Inicio: se fija arriba con fondo sólido en cuanto
  // el usuario deja de ver la parte superior del hero, igual que el resto de
  // páginas, en vez de desaparecer al hacer scroll.
  const headerEl = document.querySelector('header');
  if (headerEl && !headerEl.classList.contains('solid')) {
    const onScroll = () => {
      headerEl.classList.toggle('header-pinned', window.scrollY > 80);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
