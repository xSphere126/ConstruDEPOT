---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { withBase } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerVariant?: 'transparent' | 'solid';
  active?: 'inicio' | 'sobre-nosotros' | 'productos' | 'empleo' | 'contacto';
  bodyClass?: string;
}

const { title, description, headerVariant = 'solid', active, bodyClass } = Astro.props;

const fullTitle = `${title} · Construdepot by Quiles`;
// Astro.site solo existe una vez que se configure `site` en astro.config.mjs con el
// dominio real (ver README). Hasta entonces, canonical/OG se omiten en vez de
// publicar una URL inventada.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(withBase('/og-cover.jpg'), Astro.site) : undefined;

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'HardwareStore',
  name: 'Construdepot by Quiles',
  telephone: '+34607224454',
  email: 'info@construdepot.es',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'N-340, Partida Jubalcoy, pol. 1, núm. 74',
    postalCode: '03295',
    addressLocality: 'Elche',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  // Horario real 2026 (flyer oficial de tienda): Almacén L-V 7:30-19:00 y
  // Exposición L-V 9:00-20:00 se solapan de sobra entre semana como para
  // representarlos de cara al buscador como una única franja 7:30-20:00 (unión
  // de ambas); el sábado, en cambio, ambas áreas cierran a las 13:30 — mucho
  // antes que la franja de entre semana, así que necesita su propio tramo.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:30',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '08:30',
      closes: '13:30',
    },
  ],
  // Verificado en vivo contra la ficha real de Google Maps (mismo Place ID que el
  // mapa embebido) — no es una cifra de directorio de terceros sin confirmar.
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '247',
  },
  sameAs: [
    'https://www.instagram.com/construdepot_by_quiles/',
    'https://www.facebook.com/ConstrudepotbyQuiles/',
  ],
  ...(canonicalURL ? { url: canonicalURL.toString() } : {}),
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#41B718" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="alternate icon" href={withBase('/favicon.ico')} />
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Construdepot by Quiles" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessLd)} />
</head>
<body class={bodyClass}>
  <a href="#main" class="skip-link">Saltar al contenido</a>
  <Header variant={headerVariant} active={active} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</body>
</html>
