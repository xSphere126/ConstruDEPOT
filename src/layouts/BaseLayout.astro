---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { withBase } from '../lib/url';
import { t } from '../i18n/useTranslations';
import { isRtl, type Locale } from '../i18n/locales';
import { PAGE_PATHS, TRANSLATED_LOCALES, type PageKey } from '../i18n/pages';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headerVariant?: 'transparent' | 'solid';
  active?: 'inicio' | 'sobre-nosotros' | 'productos' | 'empleo' | 'contacto';
  bodyClass?: string;
  pageKey?: PageKey;
}

const { title, description, headerVariant = 'solid', active, bodyClass, pageKey } = Astro.props;

const locale = (Astro.currentLocale as Locale | undefined) ?? 'es';
const dir = isRtl(locale) ? 'rtl' : 'ltr';
const dict = t(locale);

const alternateLocales = pageKey ? TRANSLATED_LOCALES[pageKey] : [];
const showHreflang = alternateLocales.length > 1;

// Solo en la home española: si ya hay un idioma preferido guardado (ver
// LanguageSwitcher.astro) y esa home está traducida, se redirige una vez de
// forma silenciosa. No se toca ninguna página profunda ni se fuerza esto
// fuera de la home, para no pelearse con quien entra directo a una URL en
// español ni disparar redirecciones agresivas por idioma percibido.
const homeRedirectTargets =
  pageKey === 'home' && locale === 'es'
    ? Object.fromEntries(
        TRANSLATED_LOCALES.home.filter((loc) => loc !== 'es').map((loc) => [loc, getRelativeLocaleUrl(loc, PAGE_PATHS.home)])
      )
    : null;

const fullTitle = `${title} · Construdepot by Quiles`;
// Astro.site solo existe una vez que se configure `site` en astro.config.mjs con el
// dominio real (ver README). Hasta entonces, canonical/OG se omiten en vez de
// publicar una URL inventada.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImage = Astro.site ? new URL(withBase('/og-cover.jpg'), Astro.site) : undefined;

const ogLocaleMap: Record<Locale, string> = { es: 'es_ES', en: 'en_US', fr: 'fr_FR', ar: 'ar_AR' };

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'HardwareStore',
  name: 'Construdepot by Quiles',
  telephone: '+34607224454',
  email: 'info@construdepot.es',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'N-340, Partida Jubalcoy, pol. 1, núm. 74',
    postalCode: '03295',
    addressLocality: 'Elche',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  // Horario real 2026 (flyer oficial de tienda): Almacén L-V 7:30-19:00 y
  // Exposición L-V 9:00-20:00 se solapan de sobra entre semana como para
  // representarlos de cara al buscador como una única franja 7:30-20:00 (unión
  // de ambas); el sábado, en cambio, ambas áreas cierran a las 13:30 — mucho
  // antes que la franja de entre semana, así que necesita su propio tramo.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:30',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '08:30',
      closes: '13:30',
    },
  ],
  // Verificado en vivo contra la ficha real de Google Maps (mismo Place ID que el
  // mapa embebido) — no es una cifra de directorio de terceros sin confirmar.
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '247',
  },
  sameAs: [
    'https://www.instagram.com/construdepot_by_quiles/',
    'https://www.facebook.com/ConstrudepotbyQuiles/',
  ],
  ...(canonicalURL ? { url: canonicalURL.toString() } : {}),
};
---

<!DOCTYPE html>
<html lang={locale} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#41B718" />
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  <link rel="alternate icon" href={withBase('/favicon.ico')} />
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}

  {showHreflang && alternateLocales.map((loc) => (
    <link rel="alternate" hreflang={loc} href={new URL(getRelativeLocaleUrl(loc, PAGE_PATHS[pageKey!]), Astro.site ?? Astro.url).toString()} />
  ))}
  {showHreflang && (
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl('es', PAGE_PATHS[pageKey!]), Astro.site ?? Astro.url).toString()} />
  )}

  {locale === 'ar' && (
    <>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" />
    </>
  )}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Construdepot by Quiles" />
  <meta property="og:locale" content={ogLocaleMap[locale]} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessLd)} />
</head>
<body class={bodyClass}>
  {homeRedirectTargets && (
    <script define:vars={{ targets: homeRedirectTargets }} is:inline>
      try {
        const preferred = localStorage.getItem('preferredLocale');
        if (preferred && targets[preferred]) {
          window.location.replace(targets[preferred]);
        }
      } catch {}
    </script>
  )}
  <a href="#main" class="skip-link">{dict.skipLink}</a>
  <Header variant={headerVariant} active={active} pageKey={pageKey} />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</body>
</html>
