---
import { getEntry } from 'astro:content';
import IconInstagram from '../components/IconInstagram.astro';
import GatedEmbed from '../components/GatedEmbed.astro';
import PerondaLogo from '../components/PerondaLogo.astro';
import { todasLasMarcas } from '../data/marcas';
import { withBase } from '../lib/url';
import { t, localizedHref } from '../i18n/useTranslations';
import type { Locale } from '../i18n/locales';

const locale = (Astro.currentLocale as Locale | undefined) ?? 'es';
const dict = t(locale);
const home = dict.home;

const categoriaEntry = (await getEntry('categorias', locale)) ?? (await getEntry('categorias', 'es'));
const categorias = categoriaEntry!.data.categorias;

const snapwidgetId = import.meta.env.PUBLIC_SNAPWIDGET_ID || 'WIDGET_ID_PENDIENTE';
// Sección "Síguenos en Instagram": decidido contratar SnapWidget (plan Lite,
// widget 1128145, grid 4x2 en escritorio / 2x3 en móvil, configurado desde su
// panel — ver [[construdepot-positioning]]). El ID real va en sitio/.env como
// PUBLIC_SNAPWIDGET_ID (no es secreto, pero así no hace falta tocar código
// para cambiarlo). Sin ese valor, se sigue viendo el mosaico de marcador.
const showInstagramSection = true;

// Reseñas reales de Google: nunca se traducen (ver plan de i18n) — se
// muestran tal cual las escribieron sus autores en español, con una
// etiqueta aclaratoria cuando el idioma activo no es español.
const testimonios = [
  {
    name: 'Pere Serrano',
    badge: 'Local Guide · 68 reseñas',
    stars: 5,
    quote: 'Materiales de muy buena calidad y a muy buen precio. La amabilidad y el servicio de Pepe sin comparación. Me recomendó a un albañil, que me hizo la reforma de un baño grande en una semana. He quedado muy satisfecho con esta compañía.',
  },
  {
    name: 'Ada da Silva',
    badge: '5 reseñas',
    stars: 5,
    quote: 'Tras varias reformas siempre encontramos aquí el mejor precio y el mejor trato. Tanto Pepe como Tania son súper competentes y te ayudan a encontrar la mejor opción para cada estancia. Hemos comparado muchos sitios en estos años y la mejor calidad/precio sin duda está en Construdepot.',
  },
  {
    name: 'FERRER MASTER',
    badge: 'Local Guide · 87 reseñas',
    stars: 5,
    quote: 'Excelente almacén con materiales de construcción de primera a muy buenos precios. Super recomendable.',
  },
  {
    name: 'davidplayer87',
    badge: '14 reseñas',
    stars: 5,
    quote: 'Buen trato, buen material y muy atentos. Fuimos a varios sitios a ver material y terminamos comprando todo allí. Pepe nos dio un trato muy familiar y se adaptó a todo.',
  },
  {
    name: 'Ethan Alcaraz Sforza',
    badge: '2 reseñas',
    stars: 5,
    quote: 'Quiero agradecer el excelente trato y asesoramiento que he recibido. Me recomendaron esta empresa de materiales y la experiencia ha sido de 10. Me ayudaron a elegir el suelo para mi casa, resolvieron todas mis dudas con mucha profesionalidad y me aconsejaron la mejor opción según mis necesidades. La calidad de los materiales es excelente y el resultado final ha superado mis expectativas. Sin duda, volveré a confiar en ellos y los recomendaré a cualquiera que busque buenos materiales y un servicio cercano y profesional.',
  },
  {
    name: 'Ainoa Pastor González',
    badge: 'Local Guide · 11 reseñas',
    stars: 5,
    quote: 'Súper amables!!! Me han atendido genial he podido resolver todas mis dudas y ha encontrado justo todos los suelos y muebles exactamente como la idea que tenía en mente!!! Os lo recomiendo 100%',
  },
];

const catIcons: Record<string, string> = {
  'estructura-y-obra': '<path d="M3 21h18M5 21V10l7-7 7 7v11M9 21v-6h6v6"/>',
  'acabados-y-revestimientos': '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
  'decoracion-y-pintura': '<circle cx="13.5" cy="6.5" r="2.5"/><path d="M17.5 8.5L9 17l-5 1 1-5 8.5-8.5"/>',
  'fontaneria-y-climatizacion': '<path d="M12 2C8 6 6 9.5 6 13a6 6 0 0 0 12 0c0-3.5-2-7-6-11Z"/>',
  'jardin-y-exterior': '<path d="M12 22V12M12 12C7 12 5 9 5 5c4 0 7 2 7 7Zm0 0c0-5 3-7 7-7 0 4-2 7-7 7Z"/>',
};
---

<section class="hero">
  <img class="hero-photo" src={withBase('/images/foto-hero.jpg')} alt="Fachada real de Construdepot by Quiles en Elche, con palés de Pladur y materiales en la entrada" loading="eager" />
  <div class="hero-scrim"></div>
  <div class="hero-scrim-top"></div>

  <div class="wrap hero-inner">
    <div class="hero-content">
      <div class="eyebrow">{home.hero.eyebrow}</div>
      <h1>{home.hero.titleBefore}<em>{home.hero.titleEm}</em>{home.hero.titleAfter}</h1>
      <p class="hero-sub">{home.hero.sub}</p>
      <div class="cta-row">
        <a href={localizedHref('contacto', locale)} class="btn-primary">
          {home.hero.ctaPrimary}
          <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href={localizedHref('productos', locale)} class="btn-ghost">{home.hero.ctaGhost}</a>
      </div>
      <div class="info-strip">
        <div class="info-item"><span class="ic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg></span> {home.hero.location}</div>
        <div class="info-item"><span class="ic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span> {home.hero.hours}</div>
        <div class="badge-public"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="vertical-align:-1px; margin-inline-end:4px;"><path d="M4 12l6 6L20 6"/></svg>{home.hero.badgePublic}</div>
      </div>
    </div>
  </div>

  <button type="button" class="scroll-cue" id="scroll-cue-btn" aria-label={home.hero.scrollCue}>
    {home.hero.scrollCue}
    <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
  </button>
</section>

<section class="trust-strip" id="trust-strip" style="scroll-margin-top:110px;">
  <div class="wrap trust-strip-inner">
    <div class="trust-rating">
      <span class="stars">★★★★★</span>
      <strong>{home.trust.rating}</strong>
      <span class="trust-note">{home.trust.note}</span>
    </div>
    <a href="https://www.google.com/maps/place/?q=place_id:ChIJr7CgOzy1Yw0RxNdaWmyXfNw" target="_blank" rel="noopener" class="google-link">{home.trust.link} <span class="arrow-icon">→</span></a>
  </div>
</section>

<section class="home-section" style="background:var(--sand); padding-top:52px; padding-bottom:52px;">
  <div class="wrap">
    <div class="eyebrow-sm">{home.testimonials.eyebrow}</div>
    <h2>{home.testimonials.title}</h2>
    <p class="section-sub">{home.testimonials.sub}</p>
    <div class="grid grid-3">
      {testimonios.map((testimonio) => (
        <div class="card testimonial-card">
          <span class="stars" aria-label={`${testimonio.stars}/5`}>{'★'.repeat(testimonio.stars)}</span>
          <h3 style="margin-top:10px;">{testimonio.name}</h3>
          <p style="font-size:12.5px; color:#8a8b83; font-family:'Roboto', sans-serif; margin-bottom:12px;">{testimonio.badge}</p>
          <p>{testimonio.quote}</p>
          {locale !== 'es' && <p class="original-review-note">{dict.common.originalReviewInSpanish}</p>}
        </div>
      ))}
    </div>

    <div style="margin-top:40px; text-align:center;">
      <div class="eyebrow-sm" style="justify-content:center;">{home.projectCta.eyebrow}</div>
      <h2>{home.projectCta.title}</h2>
      <p class="section-sub" style="margin-left:auto; margin-right:auto;">{home.projectCta.sub}</p>
      <div class="project-buttons" style="justify-content:center;">
        {home.projectCta.buttons.map((p) => (
          <a href={`${localizedHref('contacto', locale)}?proyecto=${encodeURIComponent(p.param)}`} class="btn-outline">{p.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="wrap">
    <div class="eyebrow-sm">{home.howWeWork.eyebrow}</div>
    <h2>{home.howWeWork.title}</h2>
    <p class="section-sub">{home.howWeWork.sub}</p>
    <div class="grid grid-2">
      <div class="service-card">
        <div class="icon-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>
        </div>
        <h3>{home.howWeWork.particulares.title}</h3>
        <p>{home.howWeWork.particulares.desc}</p>
        <a href={localizedHref('productos', locale)} class="btn-ghost-dark">{home.howWeWork.particulares.link}</a>
      </div>
      <div class="service-card">
        <div class="icon-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l8-4 8 4v14M9 9h1M9 13h1M9 17h1M14 9h1M14 13h1M14 17h1"/></svg>
        </div>
        <h3>{home.howWeWork.profesionales.title}</h3>
        <p>{home.howWeWork.profesionales.desc}</p>
        <a href={localizedHref('contacto', locale)} class="btn-ghost-dark">{home.howWeWork.profesionales.link}</a>
      </div>
    </div>
  </div>
</section>

<section class="home-section" style="background:var(--sand); padding-bottom:76px;">
  <div class="wrap">
    <div class="eyebrow-sm">{home.catalog.eyebrow}</div>
    <h2>{home.catalog.title}</h2>
    <p class="section-sub">{home.catalog.sub}</p>
    <div class="grid grid-5">
      {categorias.map((cat) => (
        <a href={`${localizedHref('productos', locale)}#${cat.id}`} class="cat-card" style="text-decoration:none;">
          <div class="cat-icon" set:html={`<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${catIcons[cat.id] ?? ''}</svg>`} />
          <h3>{cat.nombre}</h3>
          <p>{home.catalog.teasers[cat.id]}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="home-section" style="padding-top:52px; padding-bottom:52px;">
  <div class="wrap">
    <div class="eyebrow-sm">{home.brands.eyebrow}</div>
    <h2 style="font-size:24px; margin-bottom:4px;">{home.brands.title}</h2>
    <p class="section-sub" style="margin-bottom:0;">{home.brands.sub} <a href={withBase('/proveedores/')} style="color:var(--green-deep); font-weight:600; text-decoration:underline;">{home.brands.link} <span class="arrow-icon">→</span></a></p>
  </div>
  <div class="brand-marquee">
    <div class="brand-marquee-track">
      {[...todasLasMarcas, ...todasLasMarcas].map((marca, i) => (
        <a
          href={marca.url}
          target="_blank"
          rel="noopener"
          class="brand-chip brand-marquee-item"
          aria-label={marca.nombre}
          aria-hidden={i >= todasLasMarcas.length ? 'true' : undefined}
          tabindex={i >= todasLasMarcas.length ? -1 : undefined}
        >
          {marca.logo ? (
            <img src={withBase(marca.logo)} alt={marca.nombre} class={`brand-logo${marca.white ? ' brand-logo--white' : ''}`} loading="lazy" />
          ) : marca.svg ? (
            <PerondaLogo class="brand-logo brand-logo-svg" />
          ) : (
            <span class="brand-chip-text">{marca.nombre}</span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

{showInstagramSection && (
  <section class="home-section" style="background:var(--sand);">
    <div class="wrap">
      <div class="insta-header">
        <div>
          <div class="eyebrow-sm">{home.instagram.eyebrow}</div>
          <h2 style="margin-bottom:0;">{home.instagram.title}</h2>
        </div>
        <div class="insta-handle">
          <div class="ic">
            <IconInstagram width={18} height={18} />
          </div>
          <a href="https://www.instagram.com/construdepot_by_quiles/" target="_blank" rel="noopener" class="google-link" style="border-color:var(--ink); color:var(--ink);">@construdepot_by_quiles <span class="arrow-icon">→</span></a>
        </div>
      </div>
      <div class="insta-embed-wrap">
        {snapwidgetId !== 'WIDGET_ID_PENDIENTE' ? (
          <GatedEmbed category="social" src={`https://snapwidget.com/embed/${snapwidgetId}`} title={dict.gatedEmbed.instagramTitle} label={dict.gatedEmbed.instagramLabel} class="insta-embed" />
        ) : (
          <div class="insta-fallback">
            <div class="insta-grid">
              {Array.from({ length: 4 }).map(() => (
                <div class="insta-tile"><IconInstagram width={24} height={24} strokeWidth={1.6} /></div>
              ))}
            </div>
          </div>
        )}
      </div>
      {snapwidgetId === 'WIDGET_ID_PENDIENTE' && (
        <p style="font-size:12.5px; color:var(--graphite); margin-top:16px; font-family:'Roboto', sans-serif;">⚑ PENDIENTE: SnapWidget es de pago, no gratuito. Decidir si se contrata un plan o se usa una alternativa antes de activar el widget; luego poner el ID en <code>sitio/.env</code> como <code>PUBLIC_SNAPWIDGET_ID</code>. Mientras tanto se ve el mosaico de marcador de arriba.</p>
      )}
    </div>
  </section>
)}

<section class="home-section">
  <div class="wrap">
    <div class="eyebrow-sm">{home.map.eyebrow}</div>
    <h2>{home.map.title}</h2>
    <div class="map-frame">
      <GatedEmbed category="maps" src="https://www.google.com/maps?q=Construdepot+by+Quiles,+N-340+Partida+Jubalcoy,+Elche,+Alicante&output=embed" title={dict.gatedEmbed.mapTitle} label={dict.gatedEmbed.mapLabel} />
    </div>
    <div class="map-info">
      <div class="map-info-item"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg></span> N-340, Partida Jubalcoy, pol. 1, núm. 74 · 03295 Elche, Alicante</div>
      <div class="map-info-item"><span class="ic"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span> {home.map.schedule}</div>
    </div>
  </div>
</section>

<section class="home-section" style="background:var(--sand);">
  <div class="final-cta">
    <h2>{home.finalCta.title}</h2>
    <div class="cta-buttons">
      <a href={localizedHref('contacto', locale)} class="btn-primary">
        {home.finalCta.ctaPrimary}
        <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="https://wa.me/34607224454" target="_blank" rel="noopener" class="btn-whatsapp" style="font-size:15px; padding:15px 26px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.5 0 9.96-4.46 9.96-9.96C22 6.46 17.54 2 12.04 2Zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.37-.5.07-1.02.1-3.27-.7-2.75-.98-4.53-3.76-4.67-3.94-.14-.18-1.12-1.49-1.12-2.84s.7-2.02.95-2.29c.24-.28.53-.34.7-.34h.5c.16 0 .38-.03.58.44.24.56.8 1.95.87 2.09.07.14.12.3.02.48-.09.18-.14.29-.28.45-.14.16-.29.36-.42.49-.14.14-.28.29-.12.56.16.28.7 1.16 1.51 1.88 1.04.93 1.92 1.22 2.2 1.36.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.81.86.26.14.44.2.5.32.07.12.07.68-.17 1.34Z"/></svg>
        {home.finalCta.ctaWhatsapp}
      </a>
    </div>
  </div>
</section>

<style>
  .project-buttons{ display:flex; flex-wrap:wrap; gap:12px; }

  .testimonial-card{ transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .testimonial-card:hover{ transform: translateY(-4px); border-color: var(--green); box-shadow: 0 16px 32px -20px rgba(0,0,0,.35); }

  .original-review-note{ margin-top:10px; font-size:11.5px; color:#8a8b83; font-style:italic; }
</style>

<script>
  document.getElementById('scroll-cue-btn')?.addEventListener('click', () => {
    document.getElementById('trust-strip')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
