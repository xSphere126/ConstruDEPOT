---
import { getEntry } from 'astro:content';
import PerondaLogo from '../components/PerondaLogo.astro';
import { grupos } from '../data/marcas';
import { withBase } from '../lib/url';
import { t, localizedHref } from '../i18n/useTranslations';
import type { Locale } from '../i18n/locales';

const locale = (Astro.currentLocale as Locale | undefined) ?? 'es';
const dict = t(locale);
const p = dict.proveedores;

const categoriaEntry = (await getEntry('categorias', locale)) ?? (await getEntry('categorias', 'es'));
const nombreCategoria = new Map(categoriaEntry!.data.categorias.map((c) => [c.id, c.nombre]));
---

<section class="page-banner page-banner--photo" style={`--banner-photo:url(${withBase('/images/intazulejos2.jpg')})`}>
  <div class="wrap">
    <div class="breadcrumb"><a href={localizedHref('home', locale)}>{dict.nav.inicio}</a> · <a href={localizedHref('productos', locale)}>{dict.nav.productos}</a> · {p.breadcrumbCurrent}</div>
    <h1>{p.h1}</h1>
    <p>{p.sub}</p>
  </div>
</section>

<section>
  <div class="wrap">
    {grupos.map((grupo) => (
      <div class="brand-group">
        <h2 class="eyebrow-sm">{p.groupNames[grupo.nombre] ?? grupo.nombre}</h2>
        <div class="brand-grid">
          {grupo.marcas.map((marca) => (
            <div class="brand-tile">
              <a href={marca.url} target={marca.url !== '#' ? '_blank' : undefined} rel={marca.url !== '#' ? 'noopener' : undefined} class="brand-chip" aria-label={marca.nombre}>
                {marca.logo ? (
                  <img src={withBase(marca.logo)} alt={marca.nombre} class={`brand-logo${marca.white ? ' brand-logo--white' : ''}`} />
                ) : marca.svg ? (
                  <PerondaLogo class="brand-logo brand-logo-svg" />
                ) : (
                  <span class="brand-chip-text">{marca.nombre}</span>
                )}
              </a>
              {marca.categorias?.map((catId) => (
                <a href={`${localizedHref('productos', locale)}?marca=${encodeURIComponent(marca.nombre)}#${catId}`} class="brand-category-link">{p.verEn} {nombreCategoria.get(catId)} <span class="arrow-icon">→</span></a>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section style="background:var(--sand);">
  <div class="wrap">
    <div class="cta-band" style="background:var(--ink);">
      <h3>{p.ctaText}</h3>
      <a href="https://wa.me/34607224454" class="btn-primary">{p.ctaButton} <span class="arrow-icon">→</span></a>
    </div>
  </div>
</section>
