# Copiar este archivo a .env y rellenar cuando estén disponibles.

# Feed de Instagram — SnapWidget (https://snapwidget.com) es de pago, no
# gratuito. Sección oculta (showInstagramSection en index.astro) hasta decidir
# si se contrata un plan o se usa una alternativa gratuita. Si se activa,
# conectar @construdepot_by_quiles y pegar aquí el ID del widget.
PUBLIC_SNAPWIDGET_ID=

# Formulario de contacto — ya NO usa Formspree. Envía por SMTP propio desde
# public/enviar-contacto.php. Las credenciales del buzón van en
# public/config.local.php (copiar de public/config.example.php), que se sube
# a mano por FTP al servidor y nunca a git.

# Cloudflare Turnstile — verificación anti-bot de los formularios de
# contacto y empleo. Site key (pública, esta sí va aquí) — ver
# public/config-local.example.php para la secret key (privada, va en
# config-local.php). Opcional: en blanco, el widget no se muestra y los
# formularios funcionan igual que hasta ahora.
PUBLIC_TURNSTILE_SITE_KEY=
