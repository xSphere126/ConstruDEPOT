# Fuerza https:// y el dominio sin "www" en un único salto (evita servir la
# misma web por 4 URLs distintas: http/https × con/sin www, que Google trata
# como contenido duplicado). Antes ninguna de las dos cosas se forzaba.
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://construdepot.es%{REQUEST_URI} [L,R=301]

# Cabeceras de seguridad básicas, sin afectar a la funcionalidad del sitio.
# Envueltas en <IfModule> para que no rompan nada si mod_headers no estuviera
# disponible en el hosting.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # El sitio ya fuerza https:// arriba (RewriteRule), pero eso solo actúa
  # DESPUÉS de que el navegador haga una primera petición — HSTS hace que,
  # a partir de la primera visita, el navegador ni intente http:// en el
  # futuro. max-age de 6 meses, sin includeSubDomains/preload todavía por
  # si en el futuro hiciera falta algún subdominio en http.
  Header set Strict-Transport-Security "max-age=15552000"

  # Desactiva APIs del navegador que este sitio no usa en absoluto, para
  # que un futuro XSS (o un tercero embebido comprometido) no pueda
  # pedir acceso a cámara/micrófono/ubicación desde esta página.
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content-Security-Policy: restringe de qué orígenes puede cargar
  # scripts/iframes/fuentes esta web, a los que realmente usa (Cloudflare
  # Turnstile, el widget de Instagram, el mapa de Google, Google Fonts).
  # 'unsafe-inline' en script-src y style-src es necesario porque el sitio
  # usa <script> y style="" en línea en muchas páginas (no hay nonces ni
  # nada parecido) — no es una CSP perfecta, pero igual bloquea que un XSS
  # cargue un script o se conecte a un dominio fuera de esta lista.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://snapwidget.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com https://snapwidget.com https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Sin esto, IONOS sirve su propia página de error genérica ("ERROR 404:
# ARCHIVO NO ENCONTRADO") en vez de la 404 propia del sitio (dist/404.html) —
# nunca ha habido esta directiva, así que la página 404 diseñada nunca ha
# llegado a mostrarse en producción hasta ahora.
ErrorDocument 404 /404.html

# Sin esto, Apache "adivina" archivos parecidos al que se pide y los ofrece
# como alternativa (respuesta 300 Multiple Choices) — comprobado en vivo:
# pedir /config-local.example.php (que no existe en el servidor) hacía que
# Apache sugiriera activamente /config-local.php como "documento similar",
# confirmando esa ruta a quien la sondeara. MultiViews no lo usa nada en
# este sitio (no hay archivos con el mismo nombre y distinta extensión que
# dependan de negociación de contenido), así que desactivarlo no rompe nada.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# config-local.php (y su plantilla) nunca deben pedirse por navegador: solo
# los usa "require" internamente enviar-contacto.php / enviar-empleo.php.
# Aunque ya no filtran nada al pedirlos directamente (el PHP se ejecuta sin
# imprimir salida), no hay ninguna razón para que respondan 200 en vez de
# 403 — es una capa extra de por si acaso.
<FilesMatch "^config-local(\.example)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
